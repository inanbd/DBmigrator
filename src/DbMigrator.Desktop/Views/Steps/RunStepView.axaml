<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbMigrator.Desktop.ViewModels"
             x:Class="DbMigrator.Desktop.Views.Steps.RunStepView"
             x:DataType="vm:RunStepViewModel">
  <Panel>
    <!-- Ready: what will change, an explicit tick for anything destructive, then Start. -->
    <ScrollViewer IsVisible="{Binding IsReady}">
      <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Name="ChangeTitle" Text="{Binding ChangeTitle}" Classes="h3" />
            <ItemsControl Name="ChangeSummary" ItemsSource="{Binding ChangeSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="banner warning" IsVisible="{Binding RequiresAcknowledgement}">
          <CheckBox Name="AcknowledgeDestructive" IsChecked="{Binding Acknowledged}">
            <TextBlock Text="{Binding AcknowledgementText}" TextWrapping="Wrap" />
          </CheckBox>
        </Border>
        <TextBlock Classes="help" Text="Large copies take hours: keep this computer awake and on the network." />
        <Button Name="StartButton" Classes="accent" Content="Start migration" Command="{Binding StartCommand}" HorizontalAlignment="Left" Padding="20,8" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" Width="120" />
          <TextBlock Text="{Binding BusyText}" Classes="muted" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Spacing="8" IsVisible="{Binding IsBusy}" VerticalAlignment="Top">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsBusy" />
          <Binding Path="!IsReady" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding BusyText}" />
    </StackPanel>

    <!-- Running and finished -->
    <DockPanel IsVisible="{Binding ShowsProgress}">
      <ItemsControl DockPanel.Dock="Top" Name="Phases" ItemsSource="{Binding Phases}" Margin="0,0,0,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PhaseViewModel">
            <Border Classes="card" Margin="0,0,8,0" Padding="12,8" Classes.banner="{Binding IsRunning}" Classes.info="{Binding IsRunning}">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Classes="label" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusLine}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="8">
          <ProgressBar Name="OverallProgress" Minimum="0" Maximum="100" Value="{Binding OverallPercent, Mode=OneWay}" Height="10" />
          <TextBlock Name="OverallText" Text="{Binding OverallText}" />
          <TextBlock Name="CurrentActivity" Text="{Binding CurrentActivity}" Classes="label" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentActivityDetail}" Classes="muted"
                     IsVisible="{Binding CurrentActivityDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ContentControl Content="{Binding CurrentRow}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:TableProgressRowViewModel">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="6"
                             IsVisible="{Binding IsActive}" />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </StackPanel>
      </Border>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,8">
        <TextBlock Name="Counters" Text="{Binding CountersText}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" Name="ShowFilter" ItemsSource="{Binding ShowFilters}" SelectedItem="{Binding ShowFilter}" MinWidth="130"
                  AutomationProperties.Name="Show tables" />
        <CheckBox Grid.Column="2" Name="FollowCurrent" IsChecked="{Binding FollowCurrent}" Content="Follow current table" />
        <Button Grid.Column="3" Name="StopButton" Classes="danger" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
      </Grid>

      <DataGrid Name="RunTablesGrid" ItemsSource="{Binding VisibleTables}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Status" Binding="{Binding StatusText, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" />
          <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" />
          <DataGridTextColumn Header="Table" Binding="{Binding Name, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" Width="2*" MinWidth="140" />
          <DataGridTextColumn Header="Rows copied / est." Binding="{Binding RowsText, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" />
          <DataGridTemplateColumn Header="Progress" Width="140" x:DataType="vm:TableProgressRowViewModel">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:TableProgressRowViewModel">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Margin="8,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" />
          <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedText, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" />
          <DataGridTextColumn Header="Message" Binding="{Binding Message, Mode=OneWay}" x:DataType="vm:TableProgressRowViewModel" Width="3*" MinWidth="140" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Panel>
</UserControl>
