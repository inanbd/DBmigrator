<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbMigrator.Desktop.ViewModels"
             xmlns:parts="using:DbMigrator.Desktop.Views.Parts"
             x:Class="DbMigrator.Desktop.Views.Steps.TargetStepView"
             x:DataType="vm:TargetStepViewModel">
  <Grid ColumnDefinitions="520,24,*">
    <ScrollViewer>
      <StackPanel Spacing="14" Margin="0,0,12,0">
        <StackPanel Spacing="4">
          <RadioButton Name="MigrateIntoDatabase" GroupName="TargetMode" IsChecked="{Binding MigrateIntoDatabase}" Content="Migrate into a database" />
          <RadioButton Name="ScriptOnly" GroupName="TargetMode" IsChecked="{Binding ScriptOnly}" Content="No target connection: generate a SQL script only" />
        </StackPanel>
        <parts:ConnectionFormView IsVisible="{Binding MigrateIntoDatabase}" />
        <StackPanel Spacing="8" IsVisible="{Binding ScriptOnly}">
          <TextBlock Text="Engine" Classes="label" />
          <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" HorizontalAlignment="Stretch"
                    DisplayMemberBinding="{Binding DisplayName, x:DataType=vm:ProviderOption, Mode=OneWay}" AutomationProperties.Name="Target engine" />
          <Border Classes="banner info">
            <TextBlock Name="ScriptOnlyText" Text="{Binding ScriptOnlyText}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="2" IsVisible="{Binding MigrateIntoDatabase}">
      <StackPanel Spacing="12">
        <parts:ConnectionStatusView />
        <ContentControl Name="Summary" Content="{Binding Summary}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:TargetSummaryViewModel">
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding ServerVersion}" Classes="label" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Database, StringFormat='Database {0}'}" />
                  <TextBlock Text="{Binding User, StringFormat='Login {0}'}" />
                  <TextBlock Name="ExistingText" Text="{Binding ExistingText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <TextBlock Name="MatchingText" Text="{Binding MatchingText}" TextWrapping="Wrap"
                   IsVisible="{Binding MatchingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
