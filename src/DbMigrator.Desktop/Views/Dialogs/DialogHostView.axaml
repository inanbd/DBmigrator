<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbMigrator.Desktop.ViewModels"
             x:Class="DbMigrator.Desktop.Views.Dialogs.DialogHostView"
             x:DataType="vm:DialogHostViewModel">
  <Border Name="Backdrop" IsVisible="{Binding IsOpen}" Background="{DynamicResource OverlayBrush}">
    <!-- A dialog is never taller than the window: its title and buttons stay in view, and the text between them scrolls. -->
    <ContentControl Name="DialogContent" Content="{Binding Current}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:ConfirmDialogViewModel">
          <Border Classes="dialog">
            <!-- In reading order: title, text, answers. The text takes focus (Shift+Tab) so Page Up/Down scroll it. -->
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Name="DialogTitle" Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <ScrollViewer Grid.Row="1" Name="DialogBody" HorizontalScrollBarVisibility="Disabled" Focusable="True">
                <!-- Clear of the scroll bar, which is drawn over the content. -->
                <StackPanel Spacing="12" Margin="0,0,14,0">
                  <TextBlock Name="DialogMessage" Text="{Binding Message}" TextWrapping="Wrap" />
                  <ItemsControl Name="DialogBullets" ItemsSource="{Binding Bullets}" IsVisible="{Binding HasBullets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <DockPanel Margin="0,2">
                          <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" />
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
                <!-- The safe answer is the default for Enter and Esc. -->
                <Button Name="DialogCancel" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
                <Button Name="DialogConfirm" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                        Classes.danger="{Binding IsDestructive}" Classes.accent="{Binding !IsDestructive}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:PromptDialogViewModel">
          <Border Classes="dialog">
            <StackPanel Spacing="12">
              <TextBlock Name="DialogTitle" Classes="h2" Text="{Binding Title}" />
              <TextBlock Text="{Binding Label}" Classes="label" />
              <TextBox Name="PromptText" Text="{Binding Text}" AutomationProperties.Name="{Binding Label}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="DialogCancel" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Name="DialogConfirm" Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:ErrorDialogViewModel">
          <Border Classes="dialog">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Name="DialogTitle" Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <ScrollViewer Grid.Row="1" Name="DialogBody" HorizontalScrollBarVisibility="Disabled" Focusable="True">
                <!-- Clear of the scroll bar, which is drawn over the content. -->
                <StackPanel Spacing="12" Margin="0,0,14,0">
                  <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                  <Expander Header="Details" IsVisible="{Binding HasDetails}" HorizontalAlignment="Stretch">
                    <SelectableTextBlock Text="{Binding Details}" Classes="mono" TextWrapping="Wrap" />
                  </Expander>
                </StackPanel>
              </ScrollViewer>
              <Button Grid.Row="2" Name="DialogClose" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"
                      Command="{Binding CloseCommand}" IsDefault="True" IsCancel="True" />
            </Grid>
          </Border>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Border>
</UserControl>
