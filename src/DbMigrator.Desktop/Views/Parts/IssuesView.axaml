<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbMigrator.Desktop.ViewModels"
             x:Class="DbMigrator.Desktop.Views.Parts.IssuesView"
             x:DataType="vm:IssueListViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBox Name="IssueFilter" Text="{Binding FilterText}" PlaceholderText="Filter issues" AutomationProperties.Name="Filter issues" />
      <ToggleButton Grid.Column="1" Name="ShowErrors" IsChecked="{Binding ShowErrors}" Content="{Binding ErrorsLabel}" />
      <ToggleButton Grid.Column="2" Name="ShowWarnings" IsChecked="{Binding ShowWarnings}" Content="{Binding WarningsLabel}" />
      <ToggleButton Grid.Column="3" Name="ShowNotes" IsChecked="{Binding ShowNotes}" Content="{Binding NotesLabel}" />
      <Button Grid.Column="4" Content="Copy" Command="{Binding CopyCommand}" />
      <Button Grid.Column="5" Content="Export CSV..." Command="{Binding ExportCsvCommand}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="Nothing to report." Classes="muted" IsVisible="{Binding IsEmpty}" />
    <Grid ColumnDefinitions="320,8,*">
      <ListBox Name="IssueGroups" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IssueGroupViewModel">
            <StackPanel>
              <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding SeverityText, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{Binding Count, StringFormat=' · {0:N0}', Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Code}" Classes="help mono" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ContentControl Grid.Column="2" Content="{Binding SelectedGroup}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:IssueGroupViewModel">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
                <TextBlock Text="What it means" Classes="label" />
                <TextBlock Text="{Binding Help.Meaning}" TextWrapping="Wrap" />
                <TextBlock Text="What to do" Classes="label" />
                <TextBlock Text="{Binding Help.Action}" TextWrapping="Wrap" />
              </StackPanel>
              <DataGrid Name="IssueRows" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Subject" Binding="{Binding Subject, Mode=OneWay}" x:DataType="vm:IssueRowViewModel" Width="*" MinWidth="140" />
                  <DataGridTextColumn Header="Message" Binding="{Binding Message, Mode=OneWay}" x:DataType="vm:IssueRowViewModel" Width="2*" MinWidth="140" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </DockPanel>
</UserControl>
